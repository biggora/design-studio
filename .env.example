NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_PROVIDER=supabase      # or 'mysql'
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Sync
SYNC_SECRET=
SYNC_MAX_PAGES=5
SYNC_PAGE_DELAY_MS=3000
SYNC_MIN_REQUEST_INTERVAL_MS=2500
SYNC_REQUEST_JITTER_MS=700
SYNC_CONCURRENCY=1
SYNC_USE_PLAYWRIGHT=true
SYNC_PLAYWRIGHT_HEADLESS=true
SYNC_PLAYWRIGHT_STORAGE_STATE_PATH=.cache/redbubble-storage-state.json
REDBUBBLE_SHOP_URL=
REDBUBBLE_USER_AGENT=
REDBUBBLE_COOKIE=

# Public prints API (/api/v1/*): comma-separated origins allowed via CORS; unset/empty = * (any origin)
PRINTS_API_ALLOWED_ORIGINS=
